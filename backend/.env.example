# SecureOps Backend Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to source control.

SECUREOPS_DATABASE_URL=postgresql+asyncpg://secureops:secureops@localhost:5432/secureops
SECUREOPS_REDIS_URL=redis://localhost:6379/0
# development | test | staging | production. Outside development/test the app
# refuses to start unless SECRET_KEY is a random value of 32+ characters.
SECUREOPS_ENVIRONMENT=development
SECUREOPS_SECRET_KEY=CHANGE-ME-generate-a-random-64-char-string
SECUREOPS_CORS_ORIGINS=["http://localhost:3000"]
SECUREOPS_LOG_LEVEL=INFO

# Evidence storage: local | azure_blob | s3
SECUREOPS_EVIDENCE_STORAGE_BACKEND=local
SECUREOPS_EVIDENCE_STORAGE_PATH=./evidence-store
# SECUREOPS_AZURE_STORAGE_CONNECTION_STRING=
# SECUREOPS_AWS_S3_BUCKET=

# Celery
SECUREOPS_CELERY_BROKER_URL=redis://localhost:6379/1
SECUREOPS_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Scanners
SECUREOPS_PROWLER_DOCKER_IMAGE=prowler/prowler:latest
SECUREOPS_TRIVY_DOCKER_IMAGE=aquasec/trivy:latest

# OpenTelemetry
SECUREOPS_OPENTELEMETRY_ENABLED=false
SECUREOPS_OTLP_ENDPOINT=http://localhost:4317
